{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sfx-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const root=p.join(process.cwd(),'sfx_preview');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(root,u);if(!fp.startsWith(root)){r.writeHead(403);return r.end();}f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);return r.end();}const t={'.html':'text/html; charset=utf-8','.wav':'audio/wav','.png':'image/png'}[p.extname(fp)]||'application/octet-stream';r.writeHead(200,{'Content-Type':t});r.end(d);});}).listen(8765,'127.0.0.1');"],
      "port": 8765
    }
  ]
}
